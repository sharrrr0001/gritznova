# ─── Required ────────────────────────────────────────────────────────────────
# Chatbot (Nova) LLM key. Server-side only. Never prefix with NEXT_PUBLIC_.
# Free option: Google Gemini. Create a free key at https://aistudio.google.com/apikey
# Put the real key in .env.local (git-ignored), not in this template.
GEMINI_API_KEY=

# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://gritznova.com

# ─── Chatbot (optional) ──────────────────────────────────────────────────────
# Gemini model. "gemini-flash-latest" always points to Google's current Flash model (free tier).
GEMINI_MODEL=gemini-flash-latest

# Alternative: Anthropic Claude (paid). Used if GEMINI_API_KEY is empty, or if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=gemini   # gemini | anthropic (only needed when both keys are set)

# ─── Lead + contact-form delivery (configure at least one) ───────────────────
# Option A: email via Resend (https://resend.com). Requires a verified sending domain.
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@gritznova.com
LEAD_FROM_EMAIL=GRITZNOVA Website <noreply@gritznova.com>

# Option B: any JSON webhook — Formspree endpoint, Zapier/Make hook, Google Apps Script (Sheets), CRM.
LEAD_WEBHOOK_URL=https://formspree.io/f/xgavbqvk

# ─── Public contact handoff ──────────────────────────────────────────────────
# WhatsApp number in international format, digits only (e.g. 94771234567). Leave blank to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=+91 9109117233

# ─── Analytics (optional, use either or both) ────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
